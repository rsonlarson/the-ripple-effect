import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <!-- Mobile-friendly viewport + safe-area support (iOS notch, etc.) -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <!-- Theme color controls the browser UI color on mobile (Android/Chrome, etc.) -->
    <meta name="theme-color" content="#0b0b0f" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Optional: nicer defaults when shared -->
    <meta property="og:title" content="The Ripple Effect" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/social-card.png" />

    <script
      async
      src="https://widgets.givebutter.com/latest.umd.cjs?acct=5XYg7X5gSzIuICkR&p=other"
    ></script>
  </head>

  <body class="min-h-dvh bg-background text-foreground">
    <slot />
  </body>
</html>
